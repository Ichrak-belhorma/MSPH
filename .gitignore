# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo
# ...except apps/desktop/build/, which is electron-builder's
# `buildResources` SOURCE directory (icons etc. — see electron-builder.yml
# and build/README.md there), not generated output.
!apps/desktop/build/
!apps/desktop/build/**

# Electron
apps/desktop/dist/
apps/desktop/dist-electron/
apps/desktop/release/

# Expo / React Native
apps/mobile/.expo/
apps/mobile/dist/
apps/mobile/web-build/
apps/mobile/expo-env.d.ts
apps/mobile/.kotlin/
apps/mobile/.metro-health-check*
apps/mobile/ios/
apps/mobile/android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Prisma
apps/server/prisma/dev.db*

# Env — every real .env variant is ignored; only the committed .example
# templates (desktop/mobile/server) document what to put in them.
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
!.env.example
!.env.*.example

# apps/desktop's runtime config file (see electron/main.cts) — a real one
# holds a live server URL, machine-specific; only the committed
# .example.json documents its shape.
apps/desktop/msph-config.json
!apps/desktop/msph-config.example.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# Local uploads (dev file storage)
apps/server/storage/uploads/**
!apps/server/storage/uploads/.gitkeep

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# Testing
coverage/
