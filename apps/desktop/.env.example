# Desktop app (Vite) environment variables.
#
# Development: usually not needed at all — with no VITE_API_BASE_URL set,
# a development build (`pnpm dev:desktop` / `vite dev`) automatically
# falls back to http://localhost:4000/api (see ../../packages/shared/src/
# config/index.ts + src/config.ts). Copy this file to `.env` only if your
# server runs somewhere other than localhost:4000 during development.
#
# Production: see .env.production.example instead — a production build
# (`pnpm --filter @msph/desktop build`) REQUIRES a real value and refuses
# to fall back to localhost (fails loudly at app startup instead).

VITE_API_BASE_URL=http://localhost:4000/api

# Optional — only needed if Socket.IO should point somewhere other than
# VITE_API_BASE_URL with its trailing /api stripped.
# VITE_SOCKET_URL=http://localhost:4000
