# Copy to apps/server/.env and adjust for your machine.
# This file documents every variable the server reads.

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (desktop's Vite dev
# server, Expo web, a packaged app's origin, ...). Requests with no
# Origin header at all (native mobile fetch, curl) are always allowed —
# only needed here for a browser-based client. Add :8081 if you're
# running the mobile app with `expo start --web` for local testing.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:8081

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL="postgresql://msph:msph_dev_password@localhost:5432/msph_dev?schema=public"

# --- Auth ---
# Generate strong random secrets for real environments, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- File storage ---
# LocalStorageDriver (src/storage/) writes real uploaded files under
# STORAGE_LOCAL_ROOT and serves them from STORAGE_PUBLIC_URL — used by
# POST /visits/:id/photos/upload (real multipart upload, mobile app).
# POST /visits/:id/photos (metadata-only, desktop) still exists alongside
# it. See CONTEXT.md "File storage".
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage/uploads
STORAGE_PUBLIC_URL=http://localhost:4000/uploads
