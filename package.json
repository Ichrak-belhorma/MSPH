{
  "name": "msph",
  "version": "0.1.0",
  "private": true,
  "description": "MSPH - internal field-service management system for disinfection and pest control operations",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/server build",
    "dev:server": "pnpm --filter @msph/server dev",
    "dev:desktop": "pnpm --filter @msph/desktop dev",
    "dev:mobile": "pnpm --filter @msph/mobile start",
    "dev": "pnpm run \"/^dev:(server|desktop)$/\" --parallel",
    "typecheck": "pnpm -r typecheck",
    "prisma:generate": "pnpm --filter @msph/server prisma:generate",
    "prisma:migrate": "pnpm --filter @msph/server prisma:migrate",
    "prisma:studio": "pnpm --filter @msph/server prisma:studio",
    "desktop:dev": "pnpm --filter @msph/desktop dev",
    "desktop:build": "pnpm --filter @msph/desktop build",
    "desktop:dist": "pnpm --filter @msph/desktop dist",
    "desktop:dist:win": "pnpm --filter @msph/desktop dist:win",
    "mobile:dev": "pnpm --filter @msph/mobile start",
    "mobile:build:preview": "pnpm --filter @msph/mobile exec eas build --profile preview --platform all",
    "mobile:build:production": "pnpm --filter @msph/mobile exec eas build --profile production --platform all"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
